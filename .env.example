# ==============================================================================
# ENVIRONMENT & SECURITY
# ==============================================================================
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
TRUST_PROXY=loopback,uniquelocal
METRICS_SCRAPE_TOKEN=internal-prometheus-metrics-secret-key

# Rate Limiting (auth-service)
ENABLE_RATE_LIMIT=false
AUTH_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=30
LOGIN_FAILURE_LIMIT=10
REGISTER_RATE_LIMIT_PER_HOUR=5
REFRESH_RATE_LIMIT_PER_MINUTE=30

# ==============================================================================
# DATABASES & STORAGE
# ==============================================================================
# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=kafkashop
DIRECT_URL=postgresql://admin:admin123@localhost:5432/kafkashop?schema=public

# PgBouncer Connection Pooler
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_MAX_DB_CONNECTIONS=50
DATABASE_URL=postgresql://admin:admin123@localhost:6432/kafkashop?schema=public&pgbouncer=true

# Redis (used by auth-service session tokens & order-service idempotency cache)
REDIS_PORT=6379
REDISINSIGHT_PORT=5540
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTIC_PASSWORD=elastic123
KIBANA_PORT=5601

# ==============================================================================
# MESSAGE BROKER (KAFKA & ZOOKEEPER)
# ==============================================================================
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_BROKERS=localhost:9092

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ==============================================================================
# MICROSERVICES & INGRESS PORTS
# ==============================================================================
API_GATEWAY_PORT=8000
ORDER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
DELIVERY_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004
SEARCH_SERVICE_PORT=3005
AUTH_SERVICE_PORT=3006
PRODUCT_SERVICE_PORT=3007

# ==============================================================================
# UPSTREAM URLS (used by api-gateway reverse proxy)
# ==============================================================================
AUTH_SERVICE_URL=http://auth-service:3006
PRODUCT_SERVICE_URL=http://product-service:3007
ORDER_SERVICE_URL=http://order-service:3001
SEARCH_SERVICE_URL=http://search-service:3005
ANALYTICS_SERVICE_URL=http://analytics-service:3004

# ==============================================================================
# FRONTEND (WEB)
# ==============================================================================
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8000
