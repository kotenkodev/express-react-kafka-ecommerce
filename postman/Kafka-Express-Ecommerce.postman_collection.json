    {
      "name": "Auth",
      "description": "Authentication, user registration, JWT generation, and token rotation.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response contains user details without password\", function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res).to.have.property(\"id\");",
                  "  pm.expect(res).to.have.property(\"email\");",
                  "  pm.expect(res).to.have.property(\"username\");",
                  "  pm.expect(res).to.have.property(\"role\");",
                  "  pm.expect(res).to.not.have.property(\"password\");",
                  "  pm.expect(res).to.not.have.property(\"passwordHash\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user_{{$timestamp}}\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"user_{{$timestamp}}@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates a new customer account in the system with the default role `user`."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response contains accessToken and user profile\", function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res).to.have.property(\"accessToken\");",
                  "  pm.expect(res).to.have.property(\"user\");",
                  "  pm.collectionVariables.set(\"accessToken\", res.accessToken);",
                  "});",
                  "const cookieVal = pm.cookies.get(\"refreshToken\");",
                  "if (cookieVal) {",
                  "  pm.collectionVariables.set(\"refreshToken\", cookieVal);",
                  "} else {",
                  "  const setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "  if (setCookie) {",
                  "    const match = setCookie.match(/refreshToken=([^;]+)/);",
                  "    if (match) pm.collectionVariables.set(\"refreshToken\", match[1]);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Authenticates user, issues 15-minute JWT access token, and sets Redis refresh token."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"New access token returned\", function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res).to.have.property(\"accessToken\");",
                  "  pm.collectionVariables.set(\"accessToken\", res.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Generates a new access token using the Redis refresh session."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Logout confirmation message received\", function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.message).to.eql(\"User logged out\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Revokes the Redis refresh token session and clears the client cookie."
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"User profile contains expected fields\", function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res).to.have.property(\"id\");",
                  "  pm.expect(res).to.have.property(\"email\");",
                  "  pm.expect(res).to.have.property(\"role\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Retrieves the authenticated user profile based on Bearer token."
          }
        }
      ]
    },
