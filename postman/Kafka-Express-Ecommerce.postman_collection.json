    {
      "name": "Orders",
      "description": "Order placement, listing, and state tracking.",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Order created in PENDING state\", function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res).to.have.property(\"id\");",
                  "  pm.expect(res.status).to.eql(\"PENDING\");",
                  "  pm.collectionVariables.set(\"orderId\", res.id);",
                  "});"
